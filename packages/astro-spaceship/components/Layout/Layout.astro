---

import type { FooterData, Page, SpaceshipConfig } from '../../types';

import Footer from '../Footer/Footer.astro';
import PanZoom from '../PanZoom/PanZoom.astro';
import SEO from '../SEO/SEO.astro';

export type Props = {
  config: SpaceshipConfig;
  page: Page;
  footer?: FooterData | null | undefined;
}

const { config, footer, page } = Astro.props;

const { language } = page;

---
<!doctype html>
<html class="html" lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<link rel="icon" type="image/svg+xml" href={`${config.base ?? '/'}favicon.svg`} />
    <SEO page={page} />
    <slot name="head" />
    <style is:global>
      .anchor-link {
        text-decoration: none;
        margin-left: 0.5rem;
        opacity: 0;
        transition: opacity 0.2s ease-in-out;
        color: inherit;
        display: inline-flex;
        align-items: center;
        vertical-align: middle;
      }

      h1:hover .anchor-link,
      h2:hover .anchor-link,
      h3:hover .anchor-link,
      h4:hover .anchor-link,
      h5:hover .anchor-link,
      h6:hover .anchor-link {
        opacity: 1;
      }

      .anchor-icon {
        display: inline-block;
        vertical-align: middle;
        user-select: none;
      }
    </style>
  </head>
  <body class="body">
    <div class="texture" />
    <main class="main">
      <slot />
    </main>
    <Footer data={footer}  />
    <script>
      import { initArticlePreviews } from '../../scripts/article-preview';

      window.addEventListener('MapRendered', initArticlePreviews);

      window.addEventListener('DOMContentLoaded', initArticlePreviews);
    </script>
    <script src="../MapView/LeafletMap.ts"></script>
    <PanZoom />
  </body>
</html>